table 'Category Scorecard'
	lineageTag: b02aeba2-b33e-4412-a312-319a8e915bb5

	measure 'Observed Stable-Category Product Count' = SUM('Category Scorecard'[Observed Stable-Category Product Count Value])
		formatString: #,0
		lineageTag: fd299127-e0e2-4348-bd11-36cb299d9f23

	measure 'Eligible Favorite-Movement Product Count' = SUM('Category Scorecard'[Eligible Favorite-Movement Product Count Value])
		formatString: #,0
		lineageTag: 32e458bd-fcf6-4667-9eae-2c0c4f6305f6

	measure 'Positive Favorite-Movement Breadth' = IF(HASONEVALUE('Category Scorecard'[Broad Product Category]), SELECTEDVALUE('Category Scorecard'[Positive Favorite-Movement Breadth Value]), BLANK())
		formatString: 0.0"%"
		lineageTag: 957f6f99-7624-4ab9-bfa7-491d18c151da

	measure 'Median Daily Favorite Movement per Product' = IF(HASONEVALUE('Category Scorecard'[Broad Product Category]), SELECTEDVALUE('Category Scorecard'[Median Daily Favorite Movement Value]), BLANK())
		formatString: 0.000
		lineageTag: 7a3005c8-f310-4347-a0c4-4703f7cd0b9e

	measure 'Observed Dates' = SELECTEDVALUE('Category Scorecard'[Observed Date Count])
		formatString: 0
		lineageTag: c4298655-e8e6-436a-bc0e-c9efd53d4e8c

	measure 'Breadth Wilson 95% Lower' = SELECTEDVALUE('Category Scorecard'[Breadth Wilson 95% Lower Value])
		formatString: 0.0"%"
		lineageTag: 48b62111-ae1b-4452-b746-18e1bf5189f4

	measure 'Breadth Wilson 95% Upper' = SELECTEDVALUE('Category Scorecard'[Breadth Wilson 95% Upper Value])
		formatString: 0.0"%"
		lineageTag: 9e3949b4-7557-4ad8-a0e1-5c04e23fec6e

	measure 'Breadth Wilson 95% Width' = SELECTEDVALUE('Category Scorecard'[Breadth Wilson 95% Width Value])
		formatString: 0.0" pp"
		lineageTag: 1018c78e-efee-48fa-a44d-ce21df3e979a

	measure 'Broad Product Category Count' = DISTINCTCOUNT('Category Scorecard'[Broad Product Category])
		formatString: 0
		lineageTag: f87562dd-03e8-434b-ac39-1067d85d214d

	measure 'Publishable Broad Product Category Count' = CALCULATE(DISTINCTCOUNT('Category Scorecard'[Broad Product Category]), 'Category Scorecard'[Evidence Sufficiency Tier] <> "INSUFFICIENT")
		formatString: 0
		lineageTag: 8b2c7ff1-35e9-4267-95e0-81a8c002b537

	measure 'Insufficient Broad Product Category Count' = CALCULATE(DISTINCTCOUNT('Category Scorecard'[Broad Product Category]), 'Category Scorecard'[Evidence Sufficiency Tier] = "INSUFFICIENT")
		formatString: 0
		lineageTag: 49526dec-c17e-4dd1-8203-9e8e5a030068

	measure 'Positive Favorite-Movement Breadth Display' = VAR v=[Positive Favorite-Movement Breadth] RETURN IF(ISBLANK(v), "N/A — insufficient evidence", FORMAT(v/100, "0.0%"))
		lineageTag: 0cc0ef01-4e02-42c2-b7c9-57fb6fa81565

	measure 'Median Daily Favorite Movement Display' = VAR v=[Median Daily Favorite Movement per Product] RETURN IF(ISBLANK(v), "N/A — insufficient evidence", FORMAT(v, "0.000"))
		lineageTag: 4aa3b117-82dd-40a0-8cd3-150e1c994f46

	measure 'Eligible Favorite-Movement Product Count Display' = FORMAT([Eligible Favorite-Movement Product Count], "#,0")
		lineageTag: f7414f05-04fe-4839-9afa-7b0e2b46c812

	measure 'Evidence Sufficiency Tier Display' = SELECTEDVALUE('Category Scorecard'[Evidence Sufficiency Tier], "Select one category")
		lineageTag: a899bc7f-4ab5-4ab1-a914-6259b2c8002e

	measure 'Best Category by Breadth' = VAR Ranked = FILTER(ALL('Category Scorecard'[Broad Product Category], 'Category Scorecard'[Evidence Sufficiency Tier], 'Category Scorecard'[Positive Favorite-Movement Breadth Value]), 'Category Scorecard'[Evidence Sufficiency Tier] <> "INSUFFICIENT") VAR TopRow = TOPN(1, Ranked, 'Category Scorecard'[Positive Favorite-Movement Breadth Value], DESC) RETURN CONCATENATEX(TopRow, 'Category Scorecard'[Broad Product Category], ", ")
		lineageTag: 1a2b3c4d-5e6f-4071-8192-a3b4c5d6e7f8

	measure 'Best Category Evidence Strength' = VAR Ranked = FILTER(ALL('Category Scorecard'[Broad Product Category], 'Category Scorecard'[Evidence Sufficiency Tier], 'Category Scorecard'[Positive Favorite-Movement Breadth Value]), 'Category Scorecard'[Evidence Sufficiency Tier] <> "INSUFFICIENT") VAR TopRow = TOPN(1, Ranked, 'Category Scorecard'[Positive Favorite-Movement Breadth Value], DESC) RETURN CONCATENATEX(TopRow, 'Category Scorecard'[Evidence Sufficiency Tier], ", ")
		lineageTag: 2b3c4d5e-6f70-4182-93a4-b5c6d7e8f901

